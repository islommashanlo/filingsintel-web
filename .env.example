# Origin of the Rails API (no trailing slash). Blank = same origin as this app.
# The backend must set FRONTEND_ORIGIN to this app's origin (e.g. http://localhost:5173).
VITE_API_BASE_URL=http://localhost:3000

# "true" serves fictional sample data from an in-browser mock (MSW) instead of the API.
VITE_API_MOCK=false
